	)
	(text "Layout: hot loop U7 SW -> D4 -> C19/C21 -> GND -> U7 pin 2\nwithin ~8x8 mm on F.Cu. C18 (22 uF) at U7 pin 5, L1 at pin 1,\nR22/R23 at pin 3. No signals under L1 / the SW node."
		(exclude_from_sim no)
		(at 108.458 261.874 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b1bca5cb-d516-4f8a-a73a-a3450ef56bad")
	)
